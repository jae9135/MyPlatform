NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Render API URL (trailing slash 없이). Vercel Production·Preview 모두 설정
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
# Render apps/api — CORS_ORIGINS에 Vercel 포털 URL 추가 (예: https://project-auto-platform.vercel.app)
# DBManager Supabase 적용 — API 전용 (포털이 아닌 apps/api/.env.local 에 설정)
# Supabase Dashboard → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres....
# 홈 배지: Vercel/Render **대시보드** 링크 (배포 URL과 별도)
# NEXT_PUBLIC_INFRA_VERCEL_URL=https://vercel.com/dashboard
# NEXT_PUBLIC_INFRA_RENDER_URL=https://dashboard.render.com
# NEXT_PUBLIC_INFRA_SUPABASE_URL=https://supabase.com/dashboard/project/YOUR_PROJECT
# 배포 포털 공개 URL (sitemap·robots·OG — Vercel Production 도메인)
# NEXT_PUBLIC_PORTAL_URL=https://project-auto-platform.vercel.app
# Supabase service role / secret key (서버 전용 — Dashboard의 secret key 값)
# SUPABASE_SERVICE_ROLE_KEY= 와 SUPABASE_SECRET_KEY= 둘 중 하나만 설정
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# 포털 접근 모드 — 비우거나 false: 공개 모드(로그인 없이 모든 도구 사용, 기본값)
#                  true: 기존처럼 /login 암호·체험·발급 코드 필요
# 공개 모드에서도 /admin 과 IPMS 진단(정식 로그인 + IPMS_UNLOCK_PASSWORD)은 보호됩니다.
# NEXT_PUBLIC_ 값은 빌드 시 반영 → 변경 후 npm run dev 재시작 / Vercel Redeploy 필요
NEXT_PUBLIC_PORTAL_AUTH_REQUIRED=
# 게시판(/community) 게시 방식 — 비우거나 post: 바로 게시(링크 포함 글만 관리자 승인)
#                                 pre: 모든 글 관리자 승인 후 게시
BOARD_MODERATION=
# 관리자 페이지 /admin (비우면 PORTAL_PASSWORD 사용)
ADMIN_PASSWORD=
# 포털 로그인 암호 (서버 전용 — NEXT_PUBLIC 붙이지 마세요)
PORTAL_PASSWORD=
# 1일 체험 · 1회 체험 전용 암호 (로그인 화면에서 동일 입력란, 암호값으로 구분)
TRIAL_DAY_PASSWORD=
TRIAL_ONCE_PASSWORD=
# IPMS 2차 암호 — 웹 품질·성능 진단에서 IPMS 메뉴 클릭 시 입력 (공개 모드: 누구나 메뉴는 보이고 암호로 잠금)
# 비워 두면 IPMS 기능은 열리지 않음. 서명 쿠키로 8시간 유지
IPMS_UNLOCK_PASSWORD=
# 공개 홈 문의 (표시용)
# NEXT_PUBLIC_CONTACT_EMAIL=jae9135@gmail.com
# NEXT_PUBLIC_CONTACT_PHONE=010-6280-9135
# 문의 폼 서버 발송 — Supabase 저장 + (선택) Resend 메일
# CONTACT_INBOUND_EMAIL=담당자@example.com
# Resend 테스트(onboarding@resend.dev): CONTACT_INBOUND_EMAIL은 Resend 가입 이메일과 동일해야 함
# 운영(naver 등): Resend Domains에서 DNS 인증 후 RESEND_FROM_EMAIL=noreply@your-domain.com
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=프로젝트 자동화 Platform <onboarding@resend.dev>
# 포털 프록시 → Render 공통 키 (양쪽 같게). 비우면 로컬 API는 키 없이 허용
API_ACCESS_KEY=
# 4.5MB 초과 ZIP 업로드 시 Render 직접 전송: /api/backend/direct-api 가 이 키로 15분짜리 업로드 토큰을 발급
# (키 자체는 브라우저로 보내지 않음)

# DBManager 가 운영 DB 에 닿는 기능(스크립트 적용·DB→설계서·데이터 관리·설계서↔DB 비교)의 잠금 암호.
# 비워 두면 해당 기능은 항상 잠김(안전한 기본값). DDL 생성·다운로드는 암호 없이 사용 가능.
# 특수문자(# $)가 있으면 큰따옴표로 감싸고 $ 앞에 \ 를 붙이세요. 예: DB_UNLOCK_PASSWORD="ab\$cd#e"
DB_UNLOCK_PASSWORD=
