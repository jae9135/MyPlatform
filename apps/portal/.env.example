NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Render API URL (trailing slash 없이). 브라우저는 /api/backend 프록시를 씁니다.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
# DBManager Supabase 적용 — API 전용 (포털이 아닌 apps/api/.env.local 에 설정)
# Supabase Dashboard → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres....
# 홈 배지: Vercel/Render **대시보드** 링크 (배포 URL과 별도)
# NEXT_PUBLIC_INFRA_VERCEL_URL=https://vercel.com/dashboard
# NEXT_PUBLIC_INFRA_RENDER_URL=https://dashboard.render.com
# NEXT_PUBLIC_INFRA_SUPABASE_URL=https://supabase.com/dashboard/project/YOUR_PROJECT
# 배포 포털 공개 URL (CORS 등 — 배지 링크 아님)
# NEXT_PUBLIC_PORTAL_URL=https://your-app.vercel.app
# Supabase service role / secret key (서버 전용 — Dashboard의 secret key 값)
# SUPABASE_SERVICE_ROLE_KEY= 와 SUPABASE_SECRET_KEY= 둘 중 하나만 설정
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# 관리자 페이지 /admin (비우면 PORTAL_PASSWORD 사용)
ADMIN_PASSWORD=
# 포털 로그인 암호 (서버 전용 — NEXT_PUBLIC 붙이지 마세요)
PORTAL_PASSWORD=
# 1일 체험 · 1회 체험 전용 암호 (로그인 화면에서 동일 입력란, 암호값으로 구분)
TRIAL_DAY_PASSWORD=
TRIAL_ONCE_PASSWORD=
# IPMS 공개·로그인 2차 암호 (웹 품질 진단 — 정식 로그인 후 탭 클릭 시)
IPMS_UNLOCK_PASSWORD=geo1234
# 공개 홈 문의 메일 (mailto 수신)
# NEXT_PUBLIC_CONTACT_EMAIL=jae9135@naver.com
# NEXT_PUBLIC_CONTACT_PHONE=010-6280-9135
# 포털 프록시 → Render 공통 키 (양쪽 같게). 비우면 로컬 API는 키 없이 허용
API_ACCESS_KEY=
# 4.5MB 초과 ZIP 업로드 시 Render 직접 전송에 사용 (포털 로그인 후 /api/backend/direct-api)
