# Copy to apps/api/.env.local — scripts/start-api-source-scan.ps1 loads this on startup.
#
# Supabase → Project Settings → Database → Connection string
# Use Session or Direct URI (Transaction pooler is not recommended for DDL).

DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Optional — also loaded from apps/portal/.env.local when unset here:
# API_ACCESS_KEY=
# PORTAL_PASSWORD=
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Alternative to DATABASE_URL (all required together):
# POSTGRES_HOST=db.xxxx.supabase.co
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=postgres
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require
